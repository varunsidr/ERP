// PostgreSQL is the application database for local, test, and hosted environments.
// See docs/POSTGRES_MIGRATION.md for Neon setup and retained SQLite history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Status and role values remain strings constrained by TypeScript schemas and service validation.

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  name            String
  role            String               @default("STAFF")
  active          Boolean              @default(true)
  tokenVersion    Int                  @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime             @default(now())
  auditEvents     AuditEvent[]
  actionTokens    AccountActionToken[]
}

model AccountActionToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  name               String
  description        String?
  priceCents         Int
  reorderPoint       Int                 @default(10)
  createdAt          DateTime            @default(now())
  inventoryItem      InventoryItem?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  invoiceItems       InvoiceItem[]
  returnItems        ReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]
}

model InventoryItem {
  id           String   @id @default(cuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])
  availableQty Int      @default(0)
  reservedQty  Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model InventoryMovement {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  type               String
  quantityDelta      Int      @default(0)
  reservedDelta      Int      @default(0)
  referenceType      String?
  referenceId        String?
  note               String?
  idempotencyKeyHash String?  @unique
  createdAt          DateTime @default(now())

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String?
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  supplierId            String
  supplier              Supplier            @relation(fields: [supplierId], references: [id])
  status                String              @default("DRAFT")
  items                 PurchaseOrderItem[]
  createdAt             DateTime            @default(now())
  orderedAt             DateTime?
  receivedAt            DateTime?
  receiptIdempotencyKey String?
  receipts              PurchaseReceipt[]
}

model PurchaseOrderItem {
  id              String                @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product               @relation(fields: [productId], references: [id])
  quantity        Int
  unitCostCents   Int
  receivedQty     Int                   @default(0)
  receipts        PurchaseReceiptItem[]
}

model PurchaseReceipt {
  id              String                @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  idempotencyKey  String
  requestHash     String
  createdAt       DateTime              @default(now())
  items           PurchaseReceiptItem[]

  @@unique([purchaseOrderId, idempotencyKey])
  @@index([purchaseOrderId, createdAt])
  @@index([createdAt])
}

model PurchaseReceiptItem {
  id                  String            @id @default(cuid())
  receiptId           String
  receipt             PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  quantity            Int

  @@unique([receiptId, purchaseOrderItemId])
}

model Order {
  id          String      @id @default(cuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      String      @default("DRAFT")
  items       OrderItem[]
  invoice     Invoice?
  createdAt   DateTime    @default(now())
  confirmedAt DateTime?
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
}

model Invoice {
  id          String           @id @default(cuid())
  orderId     String           @unique
  order       Order            @relation(fields: [orderId], references: [id])
  status      String           @default("PENDING")
  totalCents  Int
  dueAt       DateTime         @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'UTC') + INTERVAL '30 days')"))
  items       InvoiceItem[]
  payments    Payment[]
  creditNotes CreditNote[]
  returns     CustomerReturn[]
  createdAt   DateTime         @default(now())
  paidAt      DateTime?
}

model InvoiceItem {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
  returns        ReturnItem[]
}

model CustomerReturn {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reason         String
  amountCents    Int
  idempotencyKey String
  requestHash    String
  items          ReturnItem[]
  creditNote     CreditNote?
  createdAt      DateTime     @default(now())

  @@unique([invoiceId, idempotencyKey])
  @@index([invoiceId, createdAt])
}

model ReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  customerReturn CustomerReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItemId  String
  invoiceItem    InvoiceItem    @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  resaleable     Boolean        @default(false)

  @@unique([returnId, invoiceItemId])
  @@index([invoiceItemId])
}

model CreditNote {
  id             String         @id @default(cuid())
  invoiceId      String
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  returnId       String         @unique
  customerReturn CustomerReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  amountCents    Int
  createdAt      DateTime       @default(now())

  @@index([invoiceId, createdAt])
}

model Payment {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  amountCents    Int
  method         String   @default("manual")
  idempotencyKey String?
  createdAt      DateTime @default(now())

  @@unique([invoiceId, idempotencyKey])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
