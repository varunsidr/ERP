    .approval-form button { white-space: nowrap; }
    .user-create-page { width: min(100%, 820px); margin: 20px 0 50px; }
    .user-create-page .auth-intro { margin: 0 0 26px; }
    .user-create-page .auth-intro h1 { font-size: clamp(30px, 3vw, 38px); }
    .user-create-page .auth-panel { padding: 30px; }
    .user-create-page .auth-panel .panel-heading { margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
    .user-create-page .auth-panel form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 18px; }
    .user-create-page .auth-panel form > div { min-width: 0; }
    .user-create-page .auth-panel button[type="submit"] { grid-column: 1 / -1; justify-self: start; width: auto; min-width: 145px; margin-top: 7px; }
    .system-page { display: grid; align-content: center; min-height: min(680px, calc(100vh - 180px)); }
    .system-panel { max-width: 600px; padding: clamp(28px, 4vw, 52px); background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); }
    .system-code { display: inline-block; margin-bottom: 30px; color: #8cbeb9; font: 750 clamp(56px, 7vw, 92px)/1 'Segoe UI', Arial, sans-serif; letter-spacing: -.08em; }
    .system-panel h1 { margin: 7px 0 12px; }
    .system-panel > p:not(.eyebrow) { margin: 0 0 28px; max-width: 440px; }
    .system-brand { display: none; }
    .auth-layout .system-page { min-height: 100vh; justify-items: center; padding: 70px 24px; background: radial-gradient(circle at 10% 0, #d9eeea, transparent 40%), var(--paper); }
    .auth-layout .system-panel { width: min(100%, 560px); }
    .auth-layout .system-brand { display: flex; align-items: center; gap: 10px; width: min(100%, 560px); margin-bottom: 24px; color: var(--navy); font-size: 19px; font-weight: 750; }
    @media (max-width: 850px) {
      .app-shell { grid-template-columns: 1fr; }
      .sidebar { position: static; height: auto; padding: 13px 18px; }
      .sidebar.open { align-items: stretch; }
      .sidebar.open .sidebar-footer { display: block; }
      .mobile-menu { background: #27505a; }
      .auth-layout .auth-page { grid-template-columns: 1fr; }
      .auth-layout .auth-intro { min-height: 260px; padding: 26px clamp(24px, 6vw, 48px); }
      .auth-story { margin: 28px 0 0; }
      .auth-story h1 { margin: 8px 0; font-size: clamp(38px, 6vw, 54px); }
      .auth-story > p:not(.eyebrow) { margin-bottom: 0; font-size: 14px; }
      .auth-flow, .auth-intro-foot { display: none; }
      .auth-layout .auth-panel { width: min(100% - 48px, 440px); margin: 55px auto 70px; }
      .user-create-page .auth-panel form { grid-template-columns: 1fr; }
    }
    @media (max-width: 540px) {
      main { padding: 22px 18px 50px; }
      .panel { padding: 18px; }
      .order-section .panel-heading { flex-wrap: wrap; }
      .order-section .panel-heading > div { flex: 1 1 100%; }
      .order-section .panel-heading [data-add-order-line] { width: 100%; margin-top: 8px; }
      .auth-layout .flash { position: static; width: 100%; margin: 0; border-radius: 0; box-shadow: none; }
      .auth-layout .auth-intro { min-height: 220px; }
      .auth-story h1 { font-size: 39px; }
      .auth-layout .auth-panel { margin: 38px auto 55px; }
      .auth-form-heading { margin-bottom: 27px; }
      .auth-form-heading h2 { font-size: 32px; }
    }
    .print-only { display: none; }
    @media print {
      @page { margin: 14mm; }
      body { color: #1e2d3d; background: white; font-size: 11pt; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .app-shell { display: block; min-height: 0; }
      .sidebar, .topbar, .document-actions, .document-tabs, .confirm-dialog, .document-section form, .flash, .table-scroll-hint { display: none !important; }
      .workspace, main { width: 100%; max-width: none; padding: 0; margin: 0; }
      main { animation: none; }
      .document-page { min-height: 0; border: 0; border-radius: 0; }
      .document-header { padding: 0 0 12px; }
      .document-heading h1 { font-size: 21pt; }
      .document-id { display: none; }
      .print-only { display: inline; }
      .print-document-id { font: 10pt ui-monospace, Consolas, monospace; overflow-wrap: anywhere; }
      .document-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); break-inside: avoid; }
      .document-facts > div { padding: 10px; border-bottom: 0; }
      .document-progress { break-inside: avoid; }
      .document-section { padding: 12px 0; }
      .document-section .table-wrap { overflow: visible; }
      .document-section .table-plain { display: table; width: 100%; min-width: 0; }
      .document-section .table-plain thead { display: table-header-group; position: static; width: auto; height: auto; overflow: visible; clip-path: none; white-space: normal; }
      .document-section .table-plain tbody { display: table-row-group; }
      .document-section .table-plain tbody tr { display: table-row; break-inside: avoid; }
      .document-section .table-plain tbody td { display: table-cell; padding: 7px 6px; border-bottom: 1px solid var(--line); text-align: left; }
      .document-section .table-plain tbody td.numeric { text-align: right; }
      .document-section .table-plain tbody td::before { display: none; }
      .document-total, .document-meta { break-inside: avoid; }
      a { color: inherit; text-decoration: none; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } main { animation: none; } }
  </style>
</head>
<body class="<%= locals.isAuthenticated ? '' : 'auth-layout' %>">
  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <a class="brand" href="/dashboard"><span class="brand-mark">ME</span>mini-erp</a>
      <button class="mobile-menu" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false" data-mobile-menu>Menu</button>
      <% if (locals.isAuthenticated) { %>
        <p class="nav-label">Overview</p>
        <nav aria-label="Main navigation">
          <a href="/dashboard" <% if (pageTitle === 'Overview') { %>aria-current="page"<% } %>>Overview</a>
          <a href="/analytics" <% if (pageTitle === 'Analytics') { %>aria-current="page"<% } %>>Analytics</a>
          <a href="/account/security" <% if (pageTitle === 'Account security') { %>aria-current="page"<% } %>>Account security</a>
        </nav>
        <p class="nav-label" style="margin-top:24px">Sales</p>
        <nav aria-label="Sales navigation">
          <a href="/orders" <% if (pageTitle === 'Sales orders') { %>aria-current="page"<% } %>>Sales orders</a>
          <a href="/invoices" <% if (pageTitle === 'Invoices') { %>aria-current="page"<% } %>>Invoices</a>
          <a href="/customers" <% if (pageTitle === 'Customers') { %>aria-current="page"<% } %>>Customers</a>
        </nav>
        <p class="nav-label" style="margin-top:24px">Purchasing & stock</p>
        <nav aria-label="Purchasing navigation">
          <a href="/purchase-orders" <% if (pageTitle === 'Purchase orders') { %>aria-current="page"<% } %>>Purchase orders</a>
          <a href="/suppliers" <% if (pageTitle === 'Suppliers') { %>aria-current="page"<% } %>>Suppliers</a>
          <a href="/products" <% if (pageTitle === 'Products') { %>aria-current="page"<% } %>>Products</a>
        </nav>
        <% if (locals.can?.('users.write')) { %><p class="nav-label" style="margin-top:24px">Administration</p><nav aria-label="Administration navigation"><a href="/users" <% if (pageTitle === 'Users') { %>aria-current="page"<% } %>>Users</a><a href="/activity" <% if (pageTitle === 'Activity log') { %>aria-current="page"<% } %>>Activity log</a></nav><% } %>
        <div class="sidebar-footer"><strong><%= locals.user?.name || 'Workspace user' %></strong><%= locals.user?.role || 'Staff' %><form action="/logout" method="post" style="margin-top:14px"><%- include('csrf') %><button class="nav-action" type="submit">Log out</button></form></div>
      <% } else { %>
        <nav aria-label="Account navigation"><a href="/login">Log in</a></nav>
      <% } %>
    </aside>
    <div class="workspace">
      <header class="topbar"><span class="crumb"><strong>Operations</strong> / <%= pageTitle || 'Welcome' %></span><div class="quick-actions"><% if (locals.can?.('orders.write')) { %><a class="button secondary" href="/orders/new">New sale</a><% } %><% if (locals.can?.('purchases.write')) { %><a class="button ghost" href="/purchase-orders/new">New purchase</a><% } %></div></header>
      <main>
    <% const inlineErrorTexts = [locals.loginFieldErrors, locals.signupFieldErrors, locals.registerFieldErrors, locals.fieldErrors]
      .flatMap(errors => errors && typeof errors === 'object' ? Object.values(errors) : [])
      .concat([locals.stockFieldError, locals.paymentFieldError])
      .filter(value => typeof value === 'string' && value.length > 0); %>
    <% if (locals.error && !inlineErrorTexts.includes(String(locals.error))) { %>
      <p class="flash" role="alert"><%= error %></p>
    <% } %>
    <% if (locals.message) { %>
      <p class="flash flash-success" role="status"><%= message %></p>
    <% } %>
