<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>mini-erp</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root { --ink: #1e2d3d; --muted: #607386; --line: #dce5ed; --paper: #f4f7fa; --surface: #ffffff; --navy: #153b63; --teal: #0870a8; --mint: #d9f1e9; --amber: #e7a93c; --red: #c65a52; --shadow: 0 10px 28px rgba(21, 59, 99, .07); }
    * { box-sizing: border-box; }
    body { margin: 0; color: var(--ink); background: var(--paper); font: 15px/1.55 'Segoe UI', Arial, sans-serif; }
    a { color: var(--teal); text-decoration: none; } a:hover { text-decoration: underline; }
    .app-shell { min-height: 100vh; display: grid; grid-template-columns: 232px 1fr; }
    .sidebar { background: var(--navy); color: #eef4f9; padding: 28px 18px; display: flex; flex-direction: column; }
    .brand { display: flex; align-items: center; gap: 10px; color: white; font: 700 20px/1 'Segoe UI', Arial, sans-serif; letter-spacing: .02em; margin: 0 10px 40px; }
    .brand-mark { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 9px; background: var(--amber); color: var(--navy); font: 800 17px Arial, sans-serif; }
    .nav-label { color: #a5c1d8; font: 700 10px Arial, sans-serif; letter-spacing: .13em; text-transform: uppercase; margin: 0 11px 10px; }
    nav { display: grid; gap: 4px; } nav a, .nav-action { border: 0; border-radius: 8px; background: transparent; color: #d7e6f2; padding: 11px 12px; text-align: left; font: 600 14px Arial, sans-serif; cursor: pointer; }
    nav a:hover, nav a[aria-current="page"], .nav-action:hover { background: #285780; color: white; text-decoration: none; }
    .sidebar-footer { margin-top: auto; border-top: 1px solid #2d5664; padding: 18px 10px 0; color: #b4cccb; font: 12px Arial, sans-serif; }
    .sidebar-footer strong { display: block; color: white; font-size: 14px; margin-bottom: 3px; }
    .workspace { min-width: 0; } .topbar { min-height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 0 clamp(22px, 2vw, 40px); border-bottom: 1px solid var(--line); background: var(--surface); }
    .crumb { color: var(--muted); font: 12px Arial, sans-serif; } .crumb strong { color: var(--ink); }
    .quick-actions { display: flex; align-items: center; gap: 10px; font: 600 13px Arial, sans-serif; }
    main { width: 100%; max-width: 1680px; margin: 0 auto; padding: 28px clamp(22px, 2vw, 40px) 64px; }
    h1, h2, h3 { margin: 0; color: var(--navy); } h1 { font-size: clamp(26px, 2.5vw, 34px); line-height: 1.15; } h2 { font-size: 24px; } h3 { font-size: 17px; } p { color: var(--muted); }
    .page-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 20px; } .page-heading p:last-child { margin: 6px 0 0; } .eyebrow { color: var(--teal); font: 700 10px Arial, sans-serif; letter-spacing: .11em; text-transform: uppercase; margin: 0 0 5px; }
    .button, button { display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 7px; background: var(--teal); color: white; padding: 11px 16px; font: 700 13px Arial, sans-serif; cursor: pointer; } .button:hover, button:hover { background: #075781; text-decoration: none; } .button.secondary { background: #deeff9; color: #0a5680; } .button.ghost { background: transparent; color: var(--teal); border: 1px solid #a9cddd; }
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid #e7a93c; outline-offset: 2px; }
    .flash { border-left: 4px solid var(--red); background: #fff0ed; color: #8e3934; padding: 13px 16px; margin-bottom: 24px; font: 600 13px Arial, sans-serif; }
    .flash-success { border-left-color: #17836f; background: #e7f6f0; color: #17645f; }
    .stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; margin-bottom: 20px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); } .stats-six { grid-template-columns: repeat(6, minmax(0, 1fr)); } .stat, .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 5px; box-shadow: none; } .stat { min-width: 0; padding: 14px 18px; border: 0; border-right: 1px solid var(--line); border-radius: 0; } .stat:last-child { border-right: 0; } a.stat:hover { background: #f4f9fc; text-decoration: none; } .stat-label { color: var(--muted); font: 700 10px Arial, sans-serif; letter-spacing: .06em; text-transform: uppercase; } .stat-value { display: block; color: var(--navy); font: 700 26px 'Segoe UI', Arial, sans-serif; margin-top: 3px; white-space: nowrap; } .stat small { display:block; margin-top:2px; color:var(--muted); font-size:11px; }
    .dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .75fr); gap: 18px; align-items: start; } .panel { padding: 18px 20px; min-width: 0; } .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 12px; } .panel-heading span { color: var(--muted); font: 12px Arial, sans-serif; }
    table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--line); border-radius: 5px; overflow: hidden; box-shadow: none; } th, td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; } th { color: var(--muted); background: #f4f7fa; font: 700 10px Arial, sans-serif; letter-spacing: .06em; text-transform: uppercase; } tr:last-child td { border-bottom: 0; } td { font-size: 13px; } .table-wrap { overflow-x: auto; }
    .status { display: inline-flex; border-radius: 20px; padding: 5px 9px; font: 700 10px Arial, sans-serif; letter-spacing: .06em; text-transform: uppercase; } .status-draft, .status-pending { color: #866113; background: #fff0cf; } .status-confirmed, .status-paid, .status-settled, .status-received { color: #17645f; background: var(--mint); } .status-ordered { color: #205f82; background: #dceefa; } .status-cancelled { color: #8e3934; background: #ffe3df; }
    .search-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 18px; } input, select { width: 100%; border: 1px solid #cbd6d7; border-radius: 6px; background: white; color: var(--ink); padding: 12px 13px; font: 15px 'Segoe UI', Arial, sans-serif; } input:focus, select:focus { outline: 3px solid #c9eee6; border-color: var(--teal); } .search-input { max-width: 290px; }
    form { max-width: 620px; } form > div, form > fieldset { margin-bottom: 17px; } label { display: block; color: var(--navy); font: 700 12px Arial, sans-serif; margin-bottom: 7px; } fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 18px; } legend { color: var(--navy); font: 700 12px Arial, sans-serif; padding: 0 6px; } .form-actions, .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; } .actions form { display: inline; margin: 0; }
    .detail-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 18px; } .detail-list { display: grid; gap: 14px; margin: 0; } .detail-list dt { color: var(--muted); font: 700 10px Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; } .detail-list dd { margin: 2px 0 0; color: var(--navy); font-size: 17px; }
    .empty { padding: 35px 15px; text-align: center; color: var(--muted); } .mobile-menu { display: none; } .muted { color: var(--muted); } .mono { font: 12px ui-monospace, SFMono-Regular, Consolas, monospace; } .positive { color: var(--teal); } .warning { color: #9a6811; } .danger { color: var(--red); } .stack { display: grid; gap: 18px; } .line-items { max-width: none; } .line-item { display: grid; grid-template-columns: 2fr .7fr 1fr; gap: 12px; align-items: end; padding: 14px 0; border-bottom: 1px solid var(--line); } .line-item:last-child { border-bottom: 0; } .helper { margin: 6px 0 0; color: var(--muted); font: 12px Arial, sans-serif; } .timeline { border-left: 2px solid var(--line); margin-left: 7px; padding-left: 20px; } .timeline-item { position: relative; padding: 0 0 18px; } .timeline-item::before { content: ''; position: absolute; width: 10px; height: 10px; border-radius: 50%; left: -26px; top: 6px; background: var(--teal); } .text-right { text-align: right; }
    .section-note { margin: 0; font-size: 12px; color: var(--muted); }
    .workbench-column { display: grid; gap: 18px; min-width: 0; }
    .analytics-layout { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(290px, .8fr); align-items: start; gap: 18px; }
    .analytics-layout > * { min-width: 0; }
    @media (max-width: 1279px) { .analytics-layout { grid-template-columns: minmax(0, 1fr); } }
    .table-plain { border: 0; box-shadow: none; } .table-plain th:first-child, .table-plain td:first-child { padding-left: 0; } .table-plain th:last-child, .table-plain td:last-child { padding-right: 0; }
    .numeric { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .progress-track { display: flex; width: 100%; height: 10px; overflow: hidden; border-radius: 3px; background: #e7edf2; }
    .progress-segment { display: block; height: 100%; } .progress-draft { background: #91aec6; } .progress-ready { background: #dfaa43; } .progress-done { background: #278c6b; } .progress-critical { background: #c85b53; }
    .progress-legend { display: grid; gap: 0; margin-top: 10px; } .progress-legend a, .progress-legend div { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 13px; } .progress-legend a:last-child, .progress-legend div:last-child { border: 0; } .progress-legend strong { font-variant-numeric: tabular-nums; }
    .legend-dot { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 7px; vertical-align: middle; }
    .stock-row { padding: 10px 0; border-bottom: 1px solid var(--line); } .stock-row:last-child { border: 0; } .stock-line { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; } .stock-line strong { font-variant-numeric: tabular-nums; white-space: nowrap; } .stock-row small { color: var(--muted); } .stock-row .progress-track { margin-top: 8px; height: 7px; }
    .filter-strip { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; } .filter-strip strong { margin-right: 4px; font-size: 12px; } .filter-strip .button { padding: 7px 12px; }
    .trend-chart { display: grid; grid-template-columns: repeat(var(--chart-columns), minmax(0, 1fr)); gap: 6px; align-items: end; min-height: 215px; padding-top: 12px; border-bottom: 1px solid var(--line); } .trend-slot { display: flex; flex-direction: column; align-items: center; min-width: 0; } .trend-pair { display: flex; align-items: end; justify-content: center; gap: 3px; width: 100%; height: 170px; } .trend-bar { width: min(35%, 24px); min-height: 0; border-radius: 2px 2px 0 0; background: var(--teal); } .trend-bar.cash { background: #278c6b; } .trend-label { display: block; width: 100%; overflow: hidden; text-overflow: clip; white-space: nowrap; margin: 7px 0 4px; color: var(--muted); text-align: center; font-size: 10px; }
    .chart-legend { display: flex; flex-wrap: wrap; gap: 16px; color: var(--muted); font-size: 12px; } .chart-legend .legend-dot { margin-right: 5px; }
    .product-row { padding: 10px 0; border-bottom: 1px solid var(--line); } .product-row:last-child { border: 0; } .product-row .progress-track { height: 6px; margin-top: 7px; }
    .document-page { min-height: calc(100vh - 140px); background: var(--surface); border: 1px solid var(--line); border-radius: 5px; }
    .document-header { padding: 22px 28px 16px; } .document-heading { display: flex; justify-content: space-between; align-items: start; gap: 22px; } .document-heading h1 { font-size: 26px; } .document-id { font: 700 14px ui-monospace, Consolas, monospace; color: var(--navy); }
    .document-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 7px; } .document-actions form { margin: 0; } .document-actions .button, .document-actions button { padding: 8px 11px; border-radius: 4px; font-size: 12px; }
    .document-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 20px 0 14px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); } .document-facts > div { min-width: 0; padding: 11px 16px; border-right: 1px solid var(--line); } .document-facts > div:first-child { padding-left: 0; } .document-facts > div:last-child { border-right: 0; } .document-facts dt { color: var(--muted); font: 700 10px Arial, sans-serif; letter-spacing: .06em; text-transform: uppercase; } .document-facts dd { margin: 4px 0 0; font-size: 14px; font-weight: 600; }
    .document-progress { display: flex; align-items: center; gap: 12px; } .document-progress .progress-track { flex: 1; max-width: 360px; height: 7px; } .document-progress span { color: var(--muted); font-size: 12px; }
    .document-tabs { display: flex; gap: 24px; padding: 0 28px; border-bottom: 1px solid var(--line); } .document-tabs a { display: inline-block; padding: 10px 0; color: var(--muted); font-size: 13px; font-weight: 600; border-bottom: 2px solid transparent; } .document-tabs a:hover, .document-tabs a[aria-current="location"] { color: var(--teal); border-color: var(--teal); text-decoration: none; }
    .document-section { padding: 22px 28px; scroll-margin-top: 12px; } .document-section + .document-section { border-top: 1px solid var(--line); } .document-section h2 { font-size: 16px; margin-bottom: 10px; } .document-section .table-wrap { margin-top: 10px; } .document-section .table-plain { min-width: 680px; } .table-scroll-hint { display: none; }
    .document-total { width: min(100%, 350px); margin: 28px 0 0 auto; border-top: 1px solid var(--line); } .document-total div { display: flex; justify-content: space-between; gap: 20px; padding: 8px 0; font-size: 13px; } .document-total div:last-child { border-top: 1px solid var(--line); font-size: 17px; color: var(--navy); }
    .document-meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } .document-meta dt { color: var(--muted); font: 700 10px Arial, sans-serif; letter-spacing: .06em; text-transform: uppercase; } .document-meta dd { margin: 5px 0 0; font-size: 13px; }
    @media (max-width: 1200px) { .stats, .stats-six { grid-template-columns: repeat(3, minmax(0, 1fr)); } .stat:nth-child(3n) { border-right: 0; } .stat:nth-child(n+4) { border-top: 1px solid var(--line); } }
    @media (max-width: 850px) { .app-shell { grid-template-columns: 1fr; } .sidebar { padding: 16px 18px; } .brand { margin: 0; } .sidebar nav, .sidebar .nav-label, .sidebar-footer { display: none; } .mobile-menu { display: block; margin-left: auto; background: #255568; } .sidebar.open nav, .sidebar.open .nav-label, .sidebar.open .sidebar-footer { display: grid; } .sidebar.open .nav-label { margin-top: 24px; } .topbar { min-height: 58px; padding: 0 18px; } main { padding: 22px 18px 50px; } .dashboard-grid, .detail-grid { grid-template-columns: 1fr; } }
    @media (max-width: 540px) { .page-heading { display: block; } .page-heading .button { margin-top: 12px; } .stats, .stats-six { grid-template-columns: repeat(2, minmax(0, 1fr)); } .stat:nth-child(3n) { border-right: 1px solid var(--line); } .stat:nth-child(2n) { border-right: 0; } .stat:nth-child(n+3) { border-top: 1px solid var(--line); } .stats:not(.stats-six) .stat:nth-child(3):last-child, .stats[aria-label="Business summary"] .stat:last-child { grid-column: 1 / -1; border-right: 0; } .stat-value { font-size: 21px; } .search-row { display: block; } .search-input { max-width: none; margin-top: 12px; } th, td { padding: 10px; } .line-item { grid-template-columns: 1fr; } .quick-actions .button { padding: 7px 9px; } }
    @media (max-width: 700px) { .document-heading { display: block; } .document-actions { justify-content: flex-start; margin-top: 14px; } .document-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .document-facts > div { padding: 10px; border-bottom: 1px solid var(--line); } .document-facts > div:nth-child(2n) { border-right: 0; } .document-facts > div:nth-last-child(-n+2) { border-bottom: 0; } .document-facts > div:first-child { padding-left: 10px; } .document-header, .document-section { padding: 18px; } .document-tabs { padding: 0 18px; } .document-meta { grid-template-columns: 1fr; gap: 12px; } .table-scroll-hint { display: block; margin: 4px 0 0; color: var(--muted); font-size: 11px; } }
    /* Quiet application chrome: navigation and tables carry the hierarchy, not cards. */
    :root { --ink: #253542; --muted: #667580; --line: #dce2e6; --paper: #f5f6f7; --navy: #263b4c; --teal: #176c8a; --amber: #cf9a38; --shadow: none; }
    body { font-size: 14px; }
    .app-shell { grid-template-columns: 214px minmax(0, 1fr); }
    .sidebar { background: #fcfcfb; color: var(--ink); border-right: 1px solid var(--line); padding: 20px 12px; }
    .brand { color: var(--navy); font-size: 17px; letter-spacing: -.02em; margin: 0 8px 35px; }
    .brand:hover { text-decoration: none; }
    .brand-mark { width: 30px; height: 30px; border-radius: 4px; background: var(--navy); color: white; font: 700 11px Arial, sans-serif; letter-spacing: -.04em; }
    .nav-label { color: #7d8a94; margin: 0 12px 7px; font-size: 10px; }
    nav { gap: 1px; }
    nav a, .nav-action { border-radius: 4px; color: #40515e; font: 600 13px 'Segoe UI', Arial, sans-serif; padding: 9px 12px; }
    nav a:hover, .nav-action:hover { background: #eef3f5; color: var(--navy); }
    nav a[aria-current="page"] { background: #e8f1f4; color: #105c78; box-shadow: inset 3px 0 #287a98; }
    .sidebar-footer { border-top: 1px solid var(--line); color: var(--muted); padding: 16px 10px 0; }
    .sidebar-footer strong { color: var(--navy); }
    .sidebar-footer .nav-action { padding-left: 0; color: var(--teal); }
    .topbar { min-height: 54px; }
    main { padding-top: 23px; }
    h1 { font-size: clamp(25px, 2.1vw, 30px); letter-spacing: -.025em; }
    .page-heading { margin-bottom: 18px; }
    .page-heading p:last-child { margin-top: 3px; }
    .button, button { border-radius: 4px; padding: 9px 13px; }
    .button.secondary { background: #e6f0f4; }
    .stat-value { font-size: 24px; letter-spacing: -.025em; }
    .panel, .document-page, .stats { border-radius: 3px; }
    .panel { padding: 16px 18px; }
    .status { border-radius: 3px; padding: 3px 7px; letter-spacing: .025em; }
    table { border-radius: 0; }
    th { background: #f6f8f9; }
    tbody tr:hover { background: #f8fbfc; }
    .list-surface { background: var(--surface); border: 1px solid var(--line); border-radius: 3px; }
    .list-toolbar { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 13px 16px; border-bottom: 1px solid var(--line); }
    .list-toolbar strong { color: var(--navy); font-size: 13px; }
    .list-controls { display: flex; align-items: end; flex-wrap: wrap; gap: 8px; }
    .list-clear { min-height: 35px; padding: 7px 10px; font-size: 11px; white-space: nowrap; }
    .list-clear[hidden] { display: none; }
    .list-controls label { display: flex; flex-direction: column; gap: 3px; margin: 0; color: var(--muted); font-size: 11px; }
    .list-controls input, .list-controls select { width: 220px; min-height: 35px; padding: 7px 10px; font-size: 13px; border-radius: 3px; }
    .list-controls select { width: 155px; }
    .list-surface table { border: 0; }
    .list-surface th { position: relative; }
    .list-surface th:first-child, .list-surface td:first-child { padding-left: 16px; }
    .list-surface th:last-child, .list-surface td:last-child { padding-right: 16px; }
    .list-surface tbody tr:last-child td { border-bottom: 0; }
    .list-empty { padding: 42px 18px; text-align: center; color: var(--muted); }
    .list-empty strong { display: block; color: var(--navy); margin-bottom: 3px; }
    .list-surface .table-wrap { width: 100%; }
    .record-link { font-weight: 600; }
    .record-subline { display: block; margin-top: 2px; color: var(--muted); font-size: 11px; }
    .table-action { white-space: nowrap; font-size: 12px; }
    .list-stock { display: flex; align-items: center; gap: 10px; white-space: nowrap; }
    .list-stock .progress-track { width: 88px; height: 6px; flex: none; }
    .dashboard-grid .empty { padding: 10px 0; text-align: left; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    @media (max-width: 850px) { .app-shell { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); } .sidebar { flex-direction: row; align-items: center; flex-wrap: wrap; padding: 12px 18px; } .mobile-menu { background: var(--navy); color: white; margin-left: auto; } .sidebar.open nav, .sidebar.open .nav-label, .sidebar.open .sidebar-footer { display: grid; flex-basis: 100%; } }
    @media (max-width: 540px) { .list-toolbar { align-items: stretch; } .list-controls, .list-controls label { width: 100%; } .list-controls input, .list-controls select { width: 100%; } .quick-actions { gap: 5px; } .quick-actions .button { font-size: 11px; } }
    /* Consistent, quiet motion and form ergonomics across the workspace. */
    :root { --line: #d8e0e4; --paper: #f2f5f6; --teal: #176c8a; }
    @keyframes workspace-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    main { animation: workspace-enter 280ms ease-out both; }
    button, .button, nav a { transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease; }
    button:not(:disabled):active, .button:active { transform: translateY(1px); }
    button:disabled { cursor: not-allowed; opacity: .48; }
    :where(button, a, input, select):focus-visible { outline: 3px solid #9dd8cb; outline-offset: 2px; }
    input, select { min-height: 40px; border-radius: 4px; font-size: 14px; }
    input:hover:not(:focus), select:hover:not(:focus) { border-color: #aebec6; }
    .panel-heading h2 { letter-spacing: -.012em; }
    .interactive-chart { position: relative; min-height: 270px; overflow-x: auto; overflow-y: hidden; }
    .chart-svg { display: block; min-width: 0; height: auto; overflow: visible; }
    .chart-gridline { stroke: #e6ecef; stroke-width: 1; }
    .chart-axis-label { fill: #71808a; font: 11px 'Segoe UI', Arial, sans-serif; }
    .chart-empty-label { fill: #71808a; font: 14px 'Segoe UI', Arial, sans-serif; }
    .chart-mark { cursor: pointer; transition: opacity 150ms ease, filter 150ms ease, transform 150ms ease; }
