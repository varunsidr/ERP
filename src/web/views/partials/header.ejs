    /* Shared workspace finish */
    :root { --ink: #20303b; --muted: #60717c; --line: #dce5e8; --paper: #f4f7f7; --surface: #fff; --navy: #142c38; --teal: #086d75; --mint: #e0f2eb; --amber: #c58b31; --shadow: 0 12px 36px rgba(20, 44, 56, .055); }
