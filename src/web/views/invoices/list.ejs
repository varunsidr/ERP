<% const money = (cents) => `$${(cents / 100).toFixed(2)}`; const outstandingFor = invoice => Math.max(0, invoice.totalCents - invoice.payments.reduce((paid, payment) => paid + payment.amountCents, 0) - invoice.creditNotes.reduce((credited, credit) => credited + credit.amountCents, 0)); const outstanding = invoices.reduce((sum, invoice) => sum + outstandingFor(invoice), 0); %>
<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow">Sales / receivables</p><h1>Invoices</h1><p>Issued amounts, outstanding balances and payment status.</p></div><a class="button secondary" href="/orders">Sales orders</a></section>
  <section class="stats" aria-label="Invoice totals"><div class="stat"><span class="stat-label">Invoices</span><strong class="stat-value"><%= invoices.length %></strong></div><div class="stat"><span class="stat-label">Outstanding</span><strong class="stat-value warning" data-testid="total-outstanding"><%= money(outstanding) %></strong></div><div class="stat"><span class="stat-label">Paid invoices</span><strong class="stat-value positive"><%= invoices.filter((invoice) => invoice.status === 'PAID').length %></strong></div></section>
  <section class="list-surface" data-list-view aria-label="Invoice register">
    <div class="list-toolbar"><strong data-list-count aria-live="polite">Showing <%= invoices.length %> of <%= invoices.length %></strong><div class="list-controls"><label>Search invoices<input type="search" placeholder="Customer or invoice ID" data-list-search /></label><label>Status<select data-list-status><option value="">All statuses</option><option value="PENDING">Pending</option><option value="PAID">Paid</option><option value="SETTLED">Settled with credit</option></select></label></div></div>
    <% if (invoices.length) { const utcToday = new Date(); utcToday.setUTCHours(0,0,0,0); %><div class="table-wrap"><table id="invoice-table"><thead><tr><th>Invoice / customer</th><th>Issued</th><th>Due</th><th class="numeric">Billed</th><th class="numeric">Outstanding</th><th>Status</th></tr></thead><tbody>
      <% invoices.forEach(function (invoice) { const overdue = invoice.status === 'PENDING' && outstandingFor(invoice) > 0 && new Date(invoice.dueAt) < utcToday; %>
        <tr data-filter-row data-status="<%= invoice.status %>" data-testid="invoice-row"><td><a class="record-link" href="/invoices/<%= invoice.id %>" aria-label="Open invoice <%= invoice.id %> for <%= invoice.order.customer.name %>"><%= invoice.order.customer.name %></a><span class="record-subline mono"><%= invoice.id.slice(0, 12) %></span></td><td><%= new Date(invoice.createdAt).toLocaleDateString('en-US') %></td><td><%= new Date(invoice.dueAt).toLocaleDateString('en-US', { timeZone: 'UTC' }) %><% if (overdue) { %><br><span class="status status-cancelled">Overdue</span><% } %></td><td class="numeric"><%= money(invoice.totalCents) %></td><td class="numeric"><strong><%= money(outstandingFor(invoice)) %></strong></td><td><span class="status status-<%= invoice.status.toLowerCase() %>"><%= invoice.status === 'SETTLED' ? 'Settled with credit' : invoice.status %></span></td></tr>
      <% }) %>
    </tbody></table></div><div class="list-empty" data-list-no-results hidden><strong>No matching invoices</strong>Try another search or status.</div>
    <% } else { %><div class="list-empty"><strong>No invoices yet</strong>Confirm a sales order, then issue its invoice.</div><% } %>
  </section>
<%- include('../partials/footer') %>
