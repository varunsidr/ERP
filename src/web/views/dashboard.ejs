<% const money = cents => `$${(cents / 100).toFixed(2)}`; const activeSales = salesStages.draft + salesStages.readyToShip + salesStages.partiallyShipped + salesStages.readyToInvoice + salesStages.invoiced; const share = count => activeSales ? Math.round(count / activeSales * 100) : 0; %>
<%- include('partials/header') %>
  <section class="page-heading">
    <div>
      <p class="eyebrow">Operations / overview</p>
      <h1>Business overview</h1>
      <p>Sales, purchasing, payments and stock in one place.</p>
    </div>
    <time class="section-note" datetime="<%= asOf.toISOString() %>">As of <%= asOf.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %></time>
  </section>

  <section class="stats" aria-label="Business summary" data-testid="dashboard-summary">
    <a class="stat" href="/orders"><span class="stat-label">Open sales</span><strong class="stat-value" data-testid="open-sales-count"><%= pendingOrders %></strong><small>Draft, shipping, and ready to invoice</small></a>
    <a class="stat" href="/purchase-orders"><span class="stat-label">Open purchases</span><strong class="stat-value" data-testid="open-purchases-count"><%= openPurchaseOrders %></strong><small>Draft + ordered</small></a>
    <a class="stat" href="/invoices"><span class="stat-label">Receivables</span><strong class="stat-value" data-testid="receivables-value"><%= money(outstandingInvoiceCents) %></strong><small>Outstanding balance</small></a>
    <a class="stat" href="/invoices"><span class="stat-label">Paid invoices</span><strong class="stat-value"><%= money(paidRevenueCents) %></strong><small>Lifetime billed value paid</small></a>
    <a class="stat" href="/products"><span class="stat-label">Stock alerts</span><strong class="stat-value" data-testid="low-stock-count"><%= lowStockCount %></strong><small>Below product reorder points</small></a>
  </section>

  <section class="dashboard-grid" aria-label="Operational workbench">
    <div class="workbench-column">
      <section class="panel">
        <div class="panel-heading"><div><h3>Sales orders</h3><p class="section-note">Latest customer demand and billing stage</p></div><a href="/orders">All sales orders</a></div>
        <% if (recentOrders.length) { %>
          <div class="table-wrap responsive-summary-wrap"><table class="table-plain responsive-summary-table dashboard-recent-table"><thead><tr><th>Customer</th><th>Stage</th><th class="numeric">Order value</th><th>Created</th></tr></thead><tbody>
            <% recentOrders.forEach(function (order) { const total = order.items.reduce((sum, item) => sum + item.quantity * item.unitPriceCents, 0); const stage = order.fulfillmentStatus; %>
                <tr data-testid="recent-sales-order"><td data-label="Customer"><a href="/orders/<%= order.id %>"><strong><%= order.customer.name %></strong></a></td><td data-label="Stage"><span class="status status-<%= stage.toLowerCase() %>"><%= stage.replaceAll('_', ' ') %></span></td><td class="numeric" data-label="Order value"><%= money(total) %></td><td data-label="Created"><%= new Date(order.createdAt).toLocaleDateString('en-US') %></td></tr>
            <% }) %>
          </tbody></table></div>
        <% } else { %><div class="empty">No sales orders yet.<% if (locals.can?.('orders.write')) { %> <a href="/orders/new">Create the first order</a>.<% } %></div><% } %>
      </section>

      <section class="panel">
        <div class="panel-heading"><div><h3>Purchase orders</h3><p class="section-note">Incoming inventory and supplier commitments</p></div><a href="/purchase-orders">All purchases</a></div>
        <% if (recentPurchaseOrders.length) { %>
          <div class="table-wrap responsive-summary-wrap"><table class="table-plain responsive-summary-table dashboard-recent-table"><thead><tr><th>Supplier</th><th>Stage</th><th class="numeric">Order value</th><th>Created</th></tr></thead><tbody>
            <% recentPurchaseOrders.forEach(function (purchaseOrder) { const total = purchaseOrder.items.reduce((sum, item) => sum + item.quantity * item.unitCostCents, 0); %>
              <tr><td data-label="Supplier"><a href="/purchase-orders/<%= purchaseOrder.id %>"><strong><%= purchaseOrder.supplier.name %></strong></a></td><td data-label="Stage"><span class="status status-<%= purchaseOrder.status.toLowerCase() %>"><%= purchaseOrder.status %></span></td><td class="numeric" data-label="Order value"><%= money(total) %></td><td data-label="Created"><%= new Date(purchaseOrder.createdAt).toLocaleDateString('en-US') %></td></tr>
            <% }) %>
          </tbody></table></div>
        <% } else { %><div class="empty">No purchase orders yet. <a href="/purchase-orders/new">Start a purchase order</a>.</div><% } %>
      </section>
    </div>

    <div class="workbench-column">
      <section class="panel" data-testid="sales-flow">
        <div class="panel-heading"><div><h3>Sales flow</h3><p class="section-note"><%= activeSales %> non-cancelled orders</p></div><a href="/orders">Review</a></div>
        <% if (activeSales) { %>
          <div class="progress-track" aria-hidden="true" data-testid="sales-flow-bar">
            <span class="progress-segment progress-draft" style="width:<%= salesStages.draft / activeSales * 100 %>%"></span>
            <span class="progress-segment progress-shipping" style="width:<%= salesStages.readyToShip / activeSales * 100 %>%"></span>
            <span class="progress-segment progress-partial" style="width:<%= salesStages.partiallyShipped / activeSales * 100 %>%"></span>
            <span class="progress-segment progress-invoice" style="width:<%= salesStages.readyToInvoice / activeSales * 100 %>%"></span>
            <span class="progress-segment progress-done" style="width:<%= salesStages.invoiced / activeSales * 100 %>%"></span>
          </div>
          <div class="progress-legend" aria-label="Sales order stages">
            <div><span><i class="legend-dot progress-draft"></i>Draft</span><strong><%= salesStages.draft %> · <%= share(salesStages.draft) %>%</strong></div>
            <div><span><i class="legend-dot progress-shipping"></i>Ready to ship</span><strong><%= salesStages.readyToShip %> · <%= share(salesStages.readyToShip) %>%</strong></div>
            <div><span><i class="legend-dot progress-partial"></i>Partially shipped</span><strong><%= salesStages.partiallyShipped %> · <%= share(salesStages.partiallyShipped) %>%</strong></div>
            <div><span><i class="legend-dot progress-invoice"></i>Ready to invoice</span><strong><%= salesStages.readyToInvoice %> · <%= share(salesStages.readyToInvoice) %>%</strong></div>
            <div><span><i class="legend-dot progress-done"></i>Invoiced</span><strong><%= salesStages.invoiced %> · <%= share(salesStages.invoiced) %>%</strong></div>
          </div>
          <% if (salesStages.cancelled) { %><p class="section-note"><%= salesStages.cancelled %> cancelled orders excluded from the bar.</p><% } %>
        <% } else { %><p class="section-note">No active sales orders yet. The mix appears as orders move through billing.</p><% } %>
      </section>

      <section class="panel">
        <div class="panel-heading"><div><h3>Stock watch</h3><p class="section-note">Products below their reorder points</p></div><a href="/products">Inventory</a></div>
        <% if (lowStockProducts.length) { %>
          <% lowStockProducts.forEach(function (product) { const available = product.inventoryItem?.availableQty ?? 0; const reserved = product.inventoryItem?.reservedQty ?? 0; const usable = available - reserved; const threshold = product.reorderPoint; const fill = Math.max(0, Math.min(100, usable / threshold * 100)); const state = usable <= 0 ? 'progress-critical' : 'progress-ready'; %>
            <div class="stock-row" data-testid="low-stock-product"><div class="stock-line"><a href="/products/<%= product.id %>"><strong><%= product.name %></strong></a><strong class="<%= usable <= 0 ? 'danger' : 'warning' %>"><%= usable %> / <%= threshold %></strong></div>
              <small><%= product.sku %> · <%= reserved %> reserved · <%= usable <= 0 ? 'Critical' : 'Below reorder point' %></small>
              <div class="progress-track" role="progressbar" aria-label="<%= product.name %> usable stock against <%= threshold %>-unit alert line" aria-valuemin="0" aria-valuemax="<%= threshold %>" aria-valuenow="<%= Math.max(0, Math.min(threshold, usable)) %>"><span class="progress-segment <%= state %>" style="width:<%= fill %>%"></span></div>
            </div>
          <% }) %>
          <% if (lowStockCount > lowStockProducts.length) { %><p class="section-note"><%= lowStockCount - lowStockProducts.length %> more below threshold. <a href="/products">See all products</a>.</p><% } %>
        <% } else { %><p class="section-note">No products below their reorder points.</p><% } %>
      </section>
    </div>
  </section>
<%- include('partials/footer') %>
