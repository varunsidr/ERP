<% const money = cents => `$${(cents / 100).toFixed(2)}`; %>
<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow">Sales / order book</p><h1>Sales orders</h1><p>Customer commitments from draft through invoicing.</p></div><% if (locals.can?.('orders.write')) { %><a class="button" href="/orders/new">New sales order</a><% } %></section>
  <section class="list-surface" data-list-view aria-label="Sales order register">
    <div class="list-toolbar"><strong data-list-count aria-live="polite">Showing <%= orders.length %> of <%= orders.length %></strong><div class="list-controls"><label>Search orders<input type="search" placeholder="Customer or order ID" data-list-search /></label><label>Stage<select data-list-status><option value="">All stages</option><option value="DRAFT">Draft</option><option value="READY_TO_SHIP">Ready to ship</option><option value="PARTIALLY_SHIPPED">Partially shipped</option><option value="READY_TO_INVOICE">Ready to invoice</option><option value="INVOICED">Invoiced</option><option value="CANCELLED">Cancelled</option></select></label></div></div>
    <% if (orders.length) { %>
      <div class="table-wrap"><table id="orders-table"><thead><tr><th>Order / customer</th><th>Created</th><th class="numeric">Lines</th><th class="numeric">Value</th><th>Stage</th></tr></thead><tbody>
        <% orders.forEach(function (order) { const stage = order.fulfillmentStatus; const total = order.items.reduce((sum, item) => sum + item.quantity * item.unitPriceCents, 0); %>
          <tr data-filter-row data-status="<%= stage %>"><td><a class="record-link" href="/orders/<%= order.id %>" aria-label="Open sales order <%= order.id %> for <%= order.customer.name %>"><%= order.customer.name %></a><span class="record-subline mono"><%= order.id.slice(0, 12) %> · <%= order.customer.email %></span></td><td><%= new Date(order.createdAt).toLocaleDateString('en-US') %></td><td class="numeric"><%= order.items.length %></td><td class="numeric"><%= money(total) %></td><td><span class="status status-<%= stage.toLowerCase() %>"><%= stage.replaceAll('_', ' ') %></span></td></tr>
        <% }) %>
      </tbody></table></div>
      <div class="list-empty" data-list-no-results hidden><strong>No matching orders</strong>Try another search or stage.</div>
    <% } else { %><div class="list-empty"><strong>No sales orders yet</strong>Create an order to start tracking customer demand.</div><% } %>
  </section>
<%- include('../partials/footer') %>
